{
  "name": "empyreangate.org",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "bun run photos && react-router build && bun run scripts/postbuild.ts",
    "preview": "vite preview --outDir build/client --port 4180 --strictPort",
    "og": "bun run scripts/og.ts",
    "submissions": "bun run scripts/submissions.ts",
    "photos": "bun run scripts/photos.ts",
    "test": "playwright test",
    "test:unit": "bun test app scripts worker",
    "test:ui": "playwright test --ui",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "react-router typegen && tsc",
    "prepare": "lefthook install",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@empyrean-gate/patch-web": "github:TomSawyerLabs/empyrean-gate#web-dist",
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@react-router/node": "^8.1.0",
    "@xyflow/react": "^12.11.3",
    "isbot": "^5.1.44",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "^8.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.57.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "wrangler": "^4.149.0"
  }
}
