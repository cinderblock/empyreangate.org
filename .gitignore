# Misc
*.tsbuildinfo

# Web renditions of the photos. Originals are committed in photos/; these are
# regenerated by `bun run photos` (which `bun run build` runs first).
/public/photos/

# PWA icons, rendered from the favicon by `bun run icons` (part of the build).
/public/icons/

# Local Worker secrets for `wrangler dev`
.dev.vars
.wrangler/

# Downloaded playground submissions (bun run submissions)
/submissions/

# Downloaded failure reports (bun run reports)
/reports/
