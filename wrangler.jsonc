{
  // Cloudflare Workers static-assets deploy, run by Workers Builds. The site is
  // prerendered HTML; the one Worker script (worker/index.ts) handles only
  // `/api/*` — the playground's Submit — and everything else is served from
  // assets without waking it. Host canonicalisation (www, .com →
  // empyreangate.org) is a zone redirect rule owned by github.com/cinderblock/ops,
  // which also provisions this worker, the submissions bucket, and attaches the
  // custom domain. The name here must match that worker.
  //
  // Branches other than master build a Worker Preview at
  // https://<branch>.empyreangate.org (ops turns on preview routing for the
  // custom domain; the build marks itself noindex). What master does is set in
  // the dashboard's deploy command; see README "Deployment".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "empyreangate-org",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    // Only the API reaches the Worker; pages and files never invoke it.
    "run_worker_first": ["/api/*"],
    // Every route is prerendered to its own index.html, so a miss is a real
    // miss and should get the 404 page rather than an SPA shell.
    "not_found_handling": "404-page",
  },
  // Production answers only at empyreangate.org, not at a duplicate
  // workers.dev hostname. Preview hostnames are switched on explicitly: left to
  // its default, Wrangler ties them to workers_dev and they would go dark with
  // it, so a preview build would succeed and report no URL.
  "workers_dev": false,
  "preview_urls": true,
  // Required for `wrangler preview`, even empty. Previews don't inherit
  // bindings, so what a Preview's Submit gets is listed here. Cameron
  // (2026-10-16): Previews may use the real submissions bucket, so Submit can
  // be tried end to end on dev.empyreangate.org before launch; test objects in
  // a moderation queue do no harm. The Preview's TURNSTILE_SECRET is set with
  // `wrangler preview secret put TURNSTILE_SECRET --name dev`. The bucket
  // binding joins this block together with the production one below, once
  // the bucket exists.
  "previews": {
    "r2_buckets": [
      { "binding": "SUBMISSIONS", "bucket_name": "empyreangate-submissions" },
    ],
    "ratelimits": [
      {
        "name": "SUBMIT_LIMIT",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 },
      },
    ],
  },
  // Playground submissions go to an R2 bucket bound as SUBMISSIONS, declared
  // and created by ops (cloudflare/config/projects/empyreangate.yaml); wrangler
  // fails on a missing bucket rather than creating one. The crew's push
  // subscriptions live in the same bucket under notify/.
  "r2_buckets": [
    { "binding": "SUBMISSIONS", "bucket_name": "empyreangate-submissions" },
  ],
  // A few submissions a minute per visitor is plenty; more is a script. The
  // Worker also caps the bucket at LIMITS.perDay a day (worker/index.ts).
  // Nothing to provision: the namespace id is any integer unique in the
  // account's Workers.
  "ratelimits": [
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Secrets, set on the worker rather than here: TURNSTILE_SECRET (required
  // to accept submissions), NOTIFY_WEBHOOK (optional), and for the crew's
  // push notifications (/admin, worker/webpush.ts) VAPID_PUBLIC_KEY,
  // VAPID_PRIVATE_KEY and ADMIN_TOKEN. `bun run secrets:setup` sets all four
  // on production and the "dev" Preview after `wrangler login`
  // (scripts/secrets-setup.ts). Until a secret exists its endpoint answers 503.
  "observability": {
    "enabled": true,
  },
}
